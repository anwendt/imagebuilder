{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operator": {
      "type": "object",
      "properties": {
        "namespaceScopedMode": {"type": "boolean"},
        "watchNamespace": {"type": "string"}
      },
      "required": ["namespaceScopedMode", "watchNamespace"]
    },
    "developmentProfileAcknowledged": {
      "type": "boolean",
      "description": "Records explicit acknowledgement when development values disable production security guardrails."
    },
    "imageDigestEnforcement": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Fails Helm rendering unless every operator, builder, uploader, and provisioner image has an immutable sha256 digest. Development profiles may disable it."
        }
      },
      "required": ["enabled"]
    },
    "webhook": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enables validating webhooks. Production installs should keep this true; local development profiles may disable it."
        },
        "failurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"],
          "description": "Admission failure behavior. Production installs should use Fail; local development may use Ignore or disable webhooks."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Renders NetworkPolicies. Production installs should keep this true; local development profiles may disable it."
        },
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Allows proxy egress from operator, provider, build, and upload pods."
            },
            "cidr": {
              "type": "string",
              "minLength": 1,
              "description": "Exact proxy CIDR allowed by the NetworkPolicies, preferably a single-host /32."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["enabled", "cidr", "port"]
        },
        "workloadNamespaces": {
          "type": "array",
          "description": "Additional namespaces where VMImage build/upload Jobs run and should receive scoped egress NetworkPolicies.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "namespaceResourceGuardrails": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Renders ResourceQuota and LimitRange guardrails. Production installs should keep this true; local development profiles may disable it."
        },
        "resourceQuota": {
          "type": "object",
          "properties": {
            "hard": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["hard"]
        },
        "limitRange": {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/definitions/resourceList"
            },
            "defaultRequest": {
              "$ref": "#/definitions/resourceList"
            },
            "max": {
              "$ref": "#/definitions/resourceList"
            },
            "min": {
              "$ref": "#/definitions/resourceList"
            }
          },
          "required": ["default", "defaultRequest"]
        }
      },
      "required": ["enabled", "resourceQuota", "limitRange"]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "providerNamespace": {
      "type": "string",
      "minLength": 1,
      "description": "Namespace where PlatformProvider Deployments and Services are created."
    },
    "proxy": {
      "type": "object",
      "properties": {
        "httpProxy": {
          "type": "string",
          "minLength": 1,
          "description": "Optional HTTP proxy URL rendered as HTTP_PROXY and http_proxy in the operator container."
        },
        "httpsProxy": {
          "type": "string",
          "minLength": 1,
          "description": "Optional HTTPS proxy URL rendered as HTTPS_PROXY and https_proxy in the operator container."
        },
        "noProxy": {
          "type": "string",
          "minLength": 1,
          "description": "Optional comma-separated proxy bypass list rendered as NO_PROXY and no_proxy in the operator container."
        }
      }
    },
    "providerSecurity": {
      "type": "object",
      "properties": {
        "requireMTLS": {
          "type": "boolean",
          "description": "Requires every PlatformProvider to use spec.transport.tls.mode=Mutual. Production installs should keep this true."
        },
        "requireDigest": {
          "type": "boolean",
          "description": "Requires every PlatformProvider package to be digest-pinned. Production installs should keep this true."
        },
        "requireSignature": {
          "type": "boolean",
          "description": "Requires every PlatformProvider to opt into signature verification policy. Production installs should keep this true."
        },
        "restrictServiceAccounts": {
          "type": "boolean",
          "description": "Rejects custom PlatformProvider ServiceAccounts unless explicitly allowlisted."
        },
        "allowedServiceAccounts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "forbidServiceAccountToken": {
          "type": "boolean",
          "description": "Forbids PlatformProvider pods from automounting Kubernetes API tokens."
        },
        "allowedRegistries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["requireMTLS", "requireDigest", "requireSignature", "restrictServiceAccounts", "allowedServiceAccounts", "forbidServiceAccountToken"]
    },
    "imageSignaturePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Renders the enforcing Kyverno image signature verification policy. Must remain enabled whenever providerSecurity.requireSignature is true."
        },
        "imageReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "keyless": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "rekorUrl": {
              "type": "string",
              "minLength": 1,
              "description": "Rekor transparency log URL required by current Kyverno keyless verification."
            }
          },
          "required": ["issuer", "subject", "rekorUrl"]
        }
      },
      "required": ["enabled", "imageReferences", "keyless"]
    },
    "image": {
      "$ref": "#/definitions/imageReference"
    },
    "builderImage": {
      "$ref": "#/definitions/imageReference"
    },
    "uploaderImage": {
      "$ref": "#/definitions/imageReference"
    },
    "provisionerImages": {
      "type": "object",
      "properties": {
        "ansible": {
          "$ref": "#/definitions/imageReference"
        },
        "chef": {
          "$ref": "#/definitions/imageReference"
        },
        "custom": {
          "$ref": "#/definitions/imageReference"
        },
        "puppet": {
          "$ref": "#/definitions/imageReference"
        },
        "saltstack": {
          "$ref": "#/definitions/imageReference"
        }
      },
      "required": ["ansible", "chef", "custom", "puppet", "saltstack"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "providerSecurity": {
            "properties": {
              "requireSignature": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "imageSignaturePolicy": {
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "imageReference": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-fA-F]{64})$"
        }
      },
      "required": ["repository"],
      "anyOf": [
        {"required": ["tag"]},
        {"required": ["digest"]}
      ]
    },
    "resourceList": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
