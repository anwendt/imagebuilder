# Dockerfile for ADR-003 provisioner init-container images.
#
# Build with PROVISIONER_TYPE=ansible|chef|puppet|saltstack|custom and tag the
# resulting image accordingly. The runtime reads PROVISIONER_CONFIG_PATH and
# writes PROVISIONER_STATUS_PATH.

FROM golang:1.26.10-alpine@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba AS builder

ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache ca-certificates

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w -extldflags=-static" \
      -o /workspace/imagebuilder-provisioner \
      ./cmd/provisioner

FROM debian:12-slim@sha256:67b30a61dc87758f0caf819646104f29ecbda97d920aaf5edc834128ac8493d3

ARG PROVISIONER_TYPE=custom
# Keep the build-argument name for existing callers; the chef image uses Cinc.
ARG CHEF_VERSION=18.1.0
ARG CINC_SHA256_AMD64=fb16b41ed8e504b09a8e05830cacd8a225c0f151b9de6ea811dfcbc1cdf9d632
ARG CINC_SHA256_ARM64=79dbad588b1ffc1c14f70179339ff69a973681df97831f74e497e1dd9917ab22

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg openssh-client \
    && case "${PROVISIONER_TYPE}" in \
      ansible) \
        apt-get install -y --no-install-recommends ansible \
        && ansible-playbook --version >/dev/null ;; \
      chef) \
        arch="$(dpkg --print-architecture)" \
        && case "${arch}" in \
          amd64) checksum="${CINC_SHA256_AMD64}" ;; \
          arm64) checksum="${CINC_SHA256_ARM64}" ;; \
          *) echo "unsupported Cinc architecture: ${arch}" >&2; exit 1 ;; \
        esac \
        && curl --fail --show-error --silent --location --retry 3 --proto '=https' \
          "https://packages.cinc.sh/files/stable/cinc/${CHEF_VERSION}/debian/11/cinc_${CHEF_VERSION}-1_${arch}.deb" \
          -o /tmp/cinc.deb \
        && printf '%s  %s\n' "${checksum}" /tmp/cinc.deb | sha256sum --check --strict - \
        && dpkg-deb --info /tmp/cinc.deb >/dev/null \
        && dpkg -i /tmp/cinc.deb \
        && ln -s /opt/cinc/bin/cinc-client /usr/local/bin/chef-client \
        && ln -s /opt/cinc/bin/cinc-apply /usr/local/bin/chef-apply \
        && chef-client --version >/dev/null \
        && chef-apply --version >/dev/null \
        && rm -f /tmp/cinc.deb ;; \
      puppet) \
        apt-get install -y --no-install-recommends puppet-agent \
        && puppet --version >/dev/null ;; \
      saltstack) \
        mkdir -m 755 -p /etc/apt/keyrings \
        && curl -fsSL https://packages.broadcom.com/artifactory/api/security/keypair/SaltProjectKey/public | gpg --dearmor > /etc/apt/keyrings/salt-archive-keyring.pgp \
        && curl -fsSL https://github.com/saltstack/salt-install-guide/releases/latest/download/salt.sources > /etc/apt/sources.list.d/salt.sources \
        && apt-get update \
        && apt-get install -y --no-install-recommends salt-minion \
        && salt-call --version >/dev/null ;; \
      custom) \
        true ;; \
      *) \
        echo "unsupported PROVISIONER_TYPE=${PROVISIONER_TYPE}" >&2 \
        && exit 1 ;; \
    esac \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --home-dir /workspace --shell /usr/sbin/nologin nonroot

COPY --from=builder /workspace/imagebuilder-provisioner /imagebuilder-provisioner

ENV IMAGEBUILDER_PROVISIONER_TYPE=${PROVISIONER_TYPE}
ENV WORKSPACE_DIR=/workspace

USER 65532:65532
WORKDIR /workspace

ENTRYPOINT ["/imagebuilder-provisioner"]
