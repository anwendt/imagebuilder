# Dockerfile for the VM image upload/register container.

FROM golang:1.22-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
      -trimpath \
      -ldflags="-s -w -extldflags=-static" \
      -o /workspace/imagebuilder-uploader \
      ./cmd/uploader

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /workspace/imagebuilder-uploader /imagebuilder-uploader

USER 65532:65532
WORKDIR /workspace

ENTRYPOINT ["/imagebuilder-uploader"]
